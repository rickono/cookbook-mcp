# Deployment configuration template. See docs/stage-3-plan.md for account setup status.
# Set actual values after the Stage 3 plan is approved.
COOKBOOK_ISSUER=
COOKBOOK_AUDIENCE=
COOKBOOK_ALLOWED_SUBJECT=
COOKBOOK_JWKS_URL=
# Mac publisher only: public Native client identifier; no client secret.
COOKBOOK_PUBLISHER_CLIENT_ID=
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
COOKBOOK_RUNTIME=/data/cookbook-mcp
PORT=8000
# Publisher and runtime must use different credentials; runtime is read-only.
# Hosted reader is opt-in: omit ALL READER_* variables when disabled.
# See docs/hosted-reader.md for exact web client, callback and storage gates.
# READER_ORIGIN=https://your-host.example
# READER_CLIENT_ID=web-client-id
# READER_CLIENT_SECRET=from-secret-manager
# READER_SESSION_KEY=private-fernet-key
# Select explicitly at cutover; the default remains r2.
# READER_SESSION_BACKEND=r2
# Explicit Neon storage policy; use only with a direct endpoint and sslmode=verify-full.
# READER_SESSION_DURABILITY=neon
# READER_SESSION_DATABASE_URL=postgresql://from-secret-manager
# R2 remains required for rare OAuth correlation records when sessions use PostgreSQL.
# READER_S3_BUCKET=private-sessions-only
# READER_AWS_ACCESS_KEY_ID=session-bucket-only-key
# READER_AWS_SECRET_ACCESS_KEY=from-secret-manager
# READER_S3_ENDPOINT_URL=https://your-object-store.example
# READER_OIDC=0
# COOKBOOK_TRUSTED_PROXY_IPS=explicit-trusted-proxy-ips-or-cidrs
